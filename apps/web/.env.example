# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# Clave pública (anon o "publishable"): puede ir al navegador, la seguridad la da RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clave de servicio (service_role o "secret"): SOLO servidor. Nunca la publiques.
SUPABASE_SERVICE_ROLE_KEY=

# URL pública de la app (para los enlaces de invitación y recuperar contraseña)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# En producción: https://www.kartera.pro (kartera.pro redirige a www)

# Emails con permiso para crear invitaciones (separados por comas)
ADMIN_EMAILS=tu@email.com

# --- Datos de mercado ---
# EODHD (fondos, ETFs y acciones por ISIN): https://eodhd.com
EODHD_API_KEY=
# Índice de referencia para el "What-if" (por defecto iShares Core MSCI World)
BENCHMARK_ISIN=IE00B4L5Y983
BENCHMARK_SYMBOL=EUNL.XETRA

# Secreto para el proceso nocturno de precios (Vercel Cron lo envía solo)
CRON_SECRET=

# --- Importador con IA (opcional) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
