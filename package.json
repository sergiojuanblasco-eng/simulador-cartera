{
  "name": "kartera",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @kartera/web",
    "build": "npm run build -w @kartera/web",
    "test": "npm test -w @kartera/core && npm test -w @kartera/web",
    "typecheck": "npm run typecheck -w @kartera/core && npm run typecheck -w @kartera/web"
  },
  "engines": {
    "node": ">=20"
  }
}
